#define PI 3.1415926

bool loadGoalsFromTxt(const std::string& txt_path, std::vector<double>& goals) {
    std::ifstream file(txt_path);
    if (!file.is_open()) {
        ROS_FATAL_STREAM("Can't open file: " << txt_path);
        return false;
    }

    std::string line;
    int line_num = 0;
    goals.clear();

    while (std::getline(file, line)) {
        ++line_num;

        // 去除首尾空白（简单处理）
        size_t start = line.find_first_not_of(" \t\r\n");
        if (start == std::string::npos) {
            continue; // 空行
        }
        size_t end = line.find_last_not_of(" \t\r\n");
        line = line.substr(start, end - start + 1);

        // 跳过注释行
        if (line[0] == '#') {
            continue;
        }

        std::vector<double> parts;
        std::stringstream ss(line);
        std::string token;

        // 支持逗号或空格分隔
        while (std::getline(ss, token, ',')) {
            std::stringstream token_ss(token);
            std::string num_str;
            while (token_ss >> num_str) {
                try {
                    // 处理可能包含空格的 token（如 "1.0 2.0" 在逗号分割后仍需空格分割）
                    std::stringstream num_ss(num_str);
                    double val;
                    if (num_ss >> val) {
                        parts.push_back(val);
                    } else {
                        throw std::invalid_argument("not a number");
                    }
                } catch (const std::exception& e) {
                    ROS_ERROR_STREAM("Parse failed, lineno: " << line_num << " error: " << e.what());
                    parts.clear();
                    break;
                }
            }
        }

        // 如果没有用逗号分隔，则尝试整体按空格分割
        if (parts.empty()) {
            std::stringstream ss_space(line);
            double val;
            while (ss_space >> val) {
                parts.push_back(val);
            }
        }

        if (parts.size() != 7) {
            ROS_WARN_STREAM("Current line:" << line_num << ", size:" << parts.size() << " != 7, continue");
                          
            continue;
        }

        // 展平到 goals
        goals.insert(goals.end(), parts.begin(), parts.end());
    }

    file.close();
    return true;
}

// Constructor
geometricCtrl::geometricCtrl(const ros::NodeHandle &nh, const ros::NodeHandle &nh_private)
    : nh_(nh),
      nh_private_(nh_private),
      fail_detec_(false),
      ctrl_enable_(true),
      landing_commanded_(false),
      feedthrough_enable_(false),
      node_state_(WAITING_FOR_HOME_POSE) {
  planner_point_occ_Sub_ = nh_.subscribe("/planner/pointstate", 1, &geometricCtrl::plannerpointstateCallback, this, ros::TransportHints().tcpNoDelay());
  referenceSub_ =
      nh_.subscribe("/reference/setpoint", 1, &geometricCtrl::VisiontargetCallback, this, ros::TransportHints().tcpNoDelay());
  /* flatreferenceSub_ = nh_.subscribe("reference/flatsetpoint", 1, &geometricCtrl::flattargetCallback, this,
                                    ros::TransportHints().tcpNoDelay()); */
  yawreferenceSub_ =
      nh_.subscribe("/reference/yaw", 1, &geometricCtrl::yawtargetCallback, this, ros::TransportHints().tcpNoDelay());
  multiDOFJointSub_ = nh_.subscribe("command/trajectory", 1, &geometricCtrl::multiDOFJointCallback, this,
                                    ros::TransportHints().tcpNoDelay());
  eularPub_ = nh_.advertise<geometry_msgs::Vector3>("/eular", 10);                                    
  mavstateSub_ =
      nh_.subscribe("mavros/state", 1, &geometricCtrl::mavstateCallback, this, ros::TransportHints().tcpNoDelay());
  mavposeSub_ = nh_.subscribe("mavros/local_position/pose", 1, &geometricCtrl::mavposeCallback, this,
                              ros::TransportHints().tcpNoDelay());
  mavtwistSub_ = nh_.subscribe("mavros/local_position/velocity_local", 1, &geometricCtrl::mavtwistCallback, this,
                               ros::TransportHints().tcpNoDelay());
  ctrltriggerServ_ = nh_.advertiseService("trigger_rlcontroller", &geometricCtrl::ctrltriggerCallback, this);
  // 原来是0.01 100hz，若改为位置控制，20左右即可
  cmdloop_timer_ = nh_.createTimer(ros::Duration(0.01), &geometricCtrl::cmdloopCallback,
                                   this);  // Define timer for constant loop rate
  statusloop_timer_ = nh_.createTimer(ros::Duration(0.5), &geometricCtrl::statusloopCallback,
                                      this);  // Define timer for constant loop rate
  vision_point_process_timer_ = nh_.createTimer(ros::Duration(0.02), &geometricCtrl::visionloopCallback,
                                      this);  // Define timer for constant loop rate

  planner_target_pub_ = nh_.advertise<geometry_msgs::Point>("/waypoint_generator/waypoints", 10);
  angularVelPub_ = nh_.advertise<mavros_msgs::AttitudeTarget>("command/bodyrate_command", 1);
  referencePosePub_ = nh_.advertise<geometry_msgs::PoseStamped>("reference/pose", 1);
  target_pose_pub_ = nh_.advertise<geometry_msgs::PoseStamped>("mavros/setpoint_position/local", 10);
  posehistoryPub_ = nh_.advertise<nav_msgs::Path>("geometric_controller/path", 10);
  systemstatusPub_ = nh_.advertise<mavros_msgs::CompanionProcessStatus>("mavros/companion_process/status", 1);
  arming_client_ = nh_.serviceClient<mavros_msgs::CommandBool>("mavros/cmd/arming");
  set_mode_client_ = nh_.serviceClient<mavros_msgs::SetMode>("mavros/set_mode");
  land_service_ = nh_.advertiseService("land", &geometricCtrl::landCallback, this);
  gimbalCtrlPub_ = nh_.advertise<std_msgs::String>("/ui_xy", 10);
  px4_param_set_client_ = nh_.serviceClient<mavros_msgs::ParamSet>("mavros/param/set");
  px4_param_get_client_ = nh_.serviceClient<mavros_msgs::ParamGet>("mavros/param/get");
  //-------------------------------------ADD TEST
  raw_pub_ = nh_.advertise<mavros_msgs::PositionTarget>("/mavros/setpoint_raw/local", 10);

  nh_private_.param<string>("mavname", mav_name_, "iris");
  nh_private_.param<int>("ctrl_mode", ctrl_mode_, ERROR_QUATERNION);
  nh_private_.param<bool>("enable_sim", sim_enable_, true);
  nh_private_.param<bool>("velocity_yaw", velocity_yaw_, false);
  nh_private_.param<double>("max_acc", max_fb_acc_, 9.0);
  nh_private_.param<double>("yaw_heading", mavYaw_, 0.0);
  nh_private_.param<double>("drag_dx", dx_, 0.0);
  nh_private_.param<double>("drag_dy", dy_, 0.0);
  nh_private_.param<double>("drag_dz", dz_, 0.0);
  nh_private_.param<double>("attctrl_constant", attctrl_tau_, 0.1);
  nh_private_.param<double>("normalizedthrust_constant", norm_thrust_const_, 0.05);  // 1 / max acceleration
  nh_private_.param<double>("normalizedthrust_offset", norm_thrust_offset_, 0.1);    // 1 / max acceleration
  nh_private_.param<double>("Kp_x", Kpos_x_, 8.0);
  nh_private_.param<double>("Kp_y", Kpos_y_, 8.0);
  nh_private_.param<double>("Kp_z", Kpos_z_, 10.0);
  nh_private_.param<double>("Kv_x", Kvel_x_, 1.5);
  nh_private_.param<double>("Kv_y", Kvel_y_, 1.5);
  nh_private_.param<double>("Kv_z", Kvel_z_, 3.3);
  nh_private_.param<double>("Kiv_x", Ki_vel_x_, 0.2);
  nh_private_.param<double>("Kiv_y", Ki_vel_y_, 0.2);
  nh_private_.param<double>("Kiv_z", Ki_vel_z_, 1.0);
  nh_private_.param<int>("posehistory_window", posehistory_window_, 200);
  nh_private_.param<double>("target_pos_x", initTargetPos_x_, 0.0);
  nh_private_.param<double>("target_pos_y", initTargetPos_y_, 0.0);
  nh_private_.param<double>("target_pos_z", initTargetPos_z_, 1.5);
  nh_private_.param<int>("yaw_type", yaw_type_, 0);
  nh_private_.param<int>("control_mode", control_mode_, 0);
  nh_private_.param<int>("takeoff_mode", takeoff_mode_, 0);
  nh_private_.param<double>("takeoff_height", takeoff_height_, 1.5);
  nh_private_.param<int>("auto_type", auto_type_, 0);
  nh_private_.param<double>("sample_distance", sample_distance_, 1.5);
  // 添加参数
  nh_private_.param<double>("mc_yawrate_max", mc_yawrate_max_, 120.0);
  nh_private_.param<double>("mc_yawrate_land", mc_yawrate_land_, 0.0);

  path_to_end.clear();
  
  Eigen::Vector3d takeoff_point;
  Eigen::Vector3d initEnd_point;
  takeoff_point << 0.0, 0.0, takeoff_height_;
  initEnd_point << initTargetPos_x_ , initTargetPos_y_ , initTargetPos_z_;
  //initEnd_point << 20.0 , 20.0 , 1.5;
  //path_to_end = generatePoint(takeoff_point,initEnd_point,sample_distance_,false);
  //targetPos_ << initTargetPos_x_, initTargetPos_y_, initTargetPos_z_;  // Initial Position
  targetVel_ << 0.0, 0.0, 0.0;
  mavPos_ << 0.0, 0.0, 0.0;
  mavVel_ << 0.0, 0.0, 0.0;
  g_ << 0.0, 0.0, -9.8;
  Kpos_ << -Kpos_x_, -Kpos_y_, -Kpos_z_;
  Kvel_ << -Kvel_x_, -Kvel_y_, -Kvel_z_;
  Ki_vel_ << -Ki_vel_x_, -Ki_vel_y_, -Ki_vel_z_;

  D_ << dx_, dy_, dz_;

  tau << tau_x, tau_y, tau_z;
  last_control_ = ros::Time::now();
  traj_receive_flag_ = false;
  received_home_pose_ = false;
  Visiontarget_count_ = 0;
  Visiontarget_detect_flag_ = false;
  std::vector<double> vision_goal_point_list;
  Eigen::Vector3d path_point;
  Eigen::Vector2i yt_point;
  Eigen::Vector4d pose_point;
  
  nh_private_.param<string>("vision_goals_file", vision_goals_file_, "");
  ROS_INFO_STREAM("vision_goals_file:"<<vision_goals_file_);
  
  if (!loadGoalsFromTxt(vision_goals_file_, vision_goal_point_list)) {
      ROS_ERROR("Load vision_goals.txt Failed!");
  }

  if (vision_goal_point_list.empty()) {
      ROS_WARN("Can't Load any valid goals");
  } else {
      ROS_INFO_STREAM("Load " << (vision_goal_point_list.size() / 7) << " goals sucess");
  }
  // x, y, z, yaw, vel, holding_time, fsm_flag
  for (int i = 0; i < vision_goal_point_list.size() / 7; ++i) {
    path_point.x() = vision_goal_point_list[7 * i + 0]; //x
    path_point.y() = vision_goal_point_list[7 * i + 1]; //y
    path_point.z() = vision_goal_point_list[7 * i + 2]; //z
    path_to_end.push_back(path_point);
  
    posyaw_ = vision_goal_point_list[7 * i + 3] * PI / 180; //yaw degree -> yaw rad
    posyaw_to_end.push_back(posyaw_);

    posvel_ = vision_goal_point_list[7 * i + 4]; //vel
    posvel_to_end.push_back(posvel_);

    poshold_ = vision_goal_point_list[7 * i + 5]; //holding_time
    poshold_to_end.push_back(poshold_);

    fsm_flag_ = vision_goal_point_list[7*i + 6]; //fsm state flag
    fsm_to_end.push_back(fsm_flag_);
    
    //ROS_INFO("{VOICE TEST POINT }%f ,%f ,%f",path_point(0),path_point(1),path_point(2));
    ROS_INFO_STREAM("[VOICE TEST POINT]:"<<path_point(0)<<", "<<path_point(1)<<", "<<path_point(2)<<", "<<posyaw_<<", "<<posvel_<<", "<<poshold_<<", "<<fsm_flag_);
  }
  LOGGER::DailyLogger::getInstance().init("/home/orangepi/Documents/LOG", false, "geometricCtrl", true);
  LOGGER::DailyLogger::getInstance().Info("/home/orangepi/Documents");

  udp_shock = std::make_shared<UDPClient>("127.0.0.1", 8000);
  ros::Duration(1.0).sleep();
  ROS_INFO("Create udp_shock IP:127.0.0.1 PORT: 8000 ... ...");
  udp_shock->sendMessage("{shock_only}");
  ROS_INFO("Voice Shock 1 ... ...");
  ros::Duration(2.0).sleep();
  udp_shock->sendMessage("{shock_only}");
  ROS_INFO("Voice Shock 2 ... ...");
  ROS_INFO("Voice Shock Test ... ...");

}
