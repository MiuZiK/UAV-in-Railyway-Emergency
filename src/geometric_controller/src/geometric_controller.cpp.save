void geometricCtrl::plannerpointstateCallback(const std_msgs::Bool &msg) { planner_point_occ_state_ = msg.data; }

void geometricCtrl::multiDOFJointCallback(const trajectory_msgs::MultiDOFJointTrajectory &msg) {
  traj_receive_flag_ = true;
  trajectory_msgs::MultiDOFJointTrajectoryPoint pt = msg.points[0];
  reference_request_last_ = reference_request_now_;

  targetPos_prev_ = targetPos_;
  targetVel_prev_ = targetVel_;

  reference_request_now_ = ros::Time::now();
  reference_request_dt_ = (reference_request_now_ - reference_request_last_).toSec();

  targetPos_ << pt.transforms[0].translation.x, pt.transforms[0].translation.y, pt.transforms[0].translation.z;
  targetVel_ << pt.velocities[0].linear.x, pt.velocities[0].linear.y, pt.velocities[0].linear.z;

  targetAcc_ << pt.accelerations[0].linear.x, pt.accelerations[0].linear.y, 0.0/* pt.accelerations[0].linear.z */;
  targetJerk_ = Eigen::Vector3d::Zero();
  targetSnap_ = Eigen::Vector3d::Zero();

  if (!velocity_yaw_) {
    Eigen::Quaterniond q(pt.transforms[0].rotation.w, pt.transforms[0].rotation.x, pt.transforms[0].rotation.y,
                         pt.transforms[0].rotation.z);
    Eigen::Vector3d rpy = Eigen::Matrix3d(q).eulerAngles(0, 1, 2);  // RPY
    // if (yaw_type_ == 0)
    // {
    //   mavYaw_ = rpy(2);
    // }
    //ROS_INFO("[geometricCtrl]mavYaw_:%f",fix_mavYaw_);
  }
}

void geometricCtrl::mavposeCallback(const geometry_msgs::PoseStamped &msg) {
  ros::Time t_now = ros::Time::now();
  if (!received_home_pose_) {
    last_pos_receiver_ = t_now;
    received_home_pose_ = true;
    home_pose_ = msg.pose;
    ROS_INFO_STREAM("Home pose initialized to: " << home_pose_);
  }
  mavPos_ = toEigen(msg.pose.position);
  mavAtt_(0) = msg.pose.orientation.w;
  mavAtt_(1) = msg.pose.orientation.x;
  mavAtt_(2) = msg.pose.orientation.y;
  mavAtt_(3) = msg.pose.orientation.z;
  Eigen::Vector3d eler_ = quat2EularAngle(mavAtt_);
  geometry_msgs::Vector3 vec;
  vec.x = eler_.x();
  vec.y = eler_.y();
  vec.z = eler_.z();
  mavros_yaw = eler_.x();
  eularPub_.publish(vec);
  double pose_update_time = (t_now - last_pos_receiver_).toSec();
  if(pose_update_time > 0.05)
  {
    ROS_WARN("pose timeout %.4f", pose_update_time);
  }
  last_pos_receiver_ = t_now;
  //ROS_WARN("pose timeout %.4f", pose_update_time);
}

void geometricCtrl::mavtwistCallback(const geometry_msgs::TwistStamped &msg) {
  mavVel_ = toEigen(msg.twist.linear);
  mavRate_ = toEigen(msg.twist.angular);
}

bool geometricCtrl::landCallback(std_srvs::SetBool::Request &request, std_srvs::SetBool::Response &response) {
  node_state_ = LANDING;
  return true;
}

void geometricCtrl::Gen_temp_points(Eigen::Vector3d p_start, Eigen::Vector3d p_end, std::vector<Eigen::Vector3d>& pts){
  double dis = sqrt(pow(p_start(0) - p_end.x(), 2) +
                  pow(p_start(1) - p_end.y(), 2) +
                  pow(p_start(2) - p_end.z(), 2));
  double T = dis; //AB点之间的距离
  Eigen::Vector3d dp = p_end - p_start;                
  // double T = 1.0; 
  /*
  三次多项式轨迹的参数是：位置、速度在起点和终点处的值。这样，两个点之间的三次样条就可以确定。
  例如，设起始时刻t0，结束时刻t1，位置为p0和p1，速度为v0和v1。
  那么三次多项式可以写成p(t) = a + b(t-t0) + c(t-t0)^2 + d(t-t0)^3，然后根据四个条件（p(t0)=p0, p(t1)=p1, p’(t0)=v0, p’(t1)=v1）解出a,b,c,d四个参数。
  这样，就能生成两点的三次样条轨迹。
  */
  Eigen::Vector3d c = 3*dp/(T*T);
  Eigen::Vector3d d = -2*dp/(T*T*T);
  pts.clear();
  const double dt = 1.5;  // 采样率
  std::stringstream ss;
  ss<<"p_start:"<<p_start(0)<<","<<p_start(1)<<","<<p_start(2)<<","
  <<"p_end:"<<p_end(0)<<","<<p_end(1)<<","<<p_end(2)<<"\n";
  for(double t=dt; t<T; t+=dt) //不含起点与终点
  {
    const double t2 = t*t;
    const double t3 = t2*t;
    
    Eigen::Vector3d position = p_start + c*t2 + d*t3;
    Eigen::Vector3d velocity = 2*c*t + 3*d*t2;  // 用于验证
    pts.push_back(position);
    ss<<"interpoints:"<<position(0)<<" "<<position(1)<<" "<<position(2)<<"\n";
  }
  LOGGER::DailyLogger::getInstance().Info(ss.str().c_str());
}

void geometricCtrl::cmdloopCallback(const ros::TimerEvent &event) {

  static int cmd_fsm_num = 0;
  // 超时计数器和检测计时器
  static int overload_time_num = 0;
  static int vision_time_num = 0;
  static int hold_time_num = 0;
  if (current_state_.mode != "OFFBOARD" || !current_state_.armed )
  {
    targetPos_ = mavPos_;
    targetVel_ = Eigen::Vector3d::Zero();
    targetAcc_ = Eigen::Vector3d::Zero();
    // Eigen::Quaterniond q(mavAtt_(0), mavAtt_(1), mavAtt_(2), mavAtt_(3));
                          
    Eigen::Quaterniond q(-0.999, -0.0, -0.0, -0.0);
                         
    /*Eigen::Vector3d rpy = Eigen::Matrix3d(q).eulerAngles(0, 1, 2);  // RPY
    mavYaw_ = rpy(2);*/
    Eigen::Vector3d rot_x = q.toRotationMatrix().block(0, 0, 3, 1);
    mavYaw_         = atan2(rot_x(1), rot_x(0));
    //cout << "yaw " << mavYaw_ << endl;
    Vel_int.setZero();
  }

  geometry_msgs::PoseStamped pose;
  geometry_msgs::Point planner_point;
  Eigen::Vector3d takeoff_point;
  double distance,target_distance, distance_xy, distance_z;
  const Eigen::Vector3d takeoffa_ref = targetAcc_;
  const Eigen::Vector4d takeoffq_ref = acc2quaternion(takeoffa_ref - g_, mavYaw_);
  mavros_msgs::SetMode offb_set_mode;
  static bool isShocked = false;
  switch (node_state_) {
    case WAITING_FOR_HOME_POSE:{
      if(!received_home_pose_)
      {
        ROS_INFO("wait pose!");
        break;
      }
      //path_to_end, posyaw_to_end, posvel_to_end, poshold_to_end, fsm_to_end
      // 先确保服务就绪
      if (!ros::service::waitForService("/mavros/param/set", ros::Duration(3.0))) {
          ROS_WARN("Param service not ready, delaying yawrate set...");
          break;  // 保持当前状态，下次再尝试
      }
      
      // 服务就绪后设置参数
      if(!checkParamValue("MC_YAWRATE_MAX", 120.0 ,0.1))
      {
        if(px4_param_set("MC_YAWRATE_MAX", 120.0)) {
          ROS_INFO("YAWRATE set ok...");
          // 状态转移或其他逻辑
        } else {
          ROS_WARN("PX4 set yawrate failed, direct auto land.");
        }
      }
      
      if(!checkParamValue("MPC_YAWRAUTO_MAX", 45.0 ,0.1))
      {
        if(px4_param_set("MPC_YAWRAUTO_MAX", 45.0)) {
            ROS_INFO("YAWRATE set ok...");
        }
        else
        {
          ROS_WARN("PX4 set yawrate failed.");
        }
      }
      {
        float mc_yawrate_max;
        px4_param_get("MC_YAWRATE_MAX", mc_yawrate_max);
      }
      {
        float mpc_yawrauto_max;
        px4_param_get("MPC_YAWRAUTO_MAX", mpc_yawrauto_max);
      }
      // 这里的处理逻辑是，定高高度的调整。
      takeoff_point.x() = 0.0;
      takeoff_point.y() = 0.0;
      takeoff_point.z() = takeoff_height_;
      pose_point_ = takeoffq_ref;

      mavros_msgs::PositionTarget raw_setpoint;
      raw_setpoint.header.frame_id = "map";
      raw_setpoint.header.stamp = ros::Time::now();
      raw_setpoint.coordinate_frame = mavros_msgs::PositionTarget::FRAME_LOCAL_NED;

      raw_setpoint.type_mask = (mavros_msgs::PositionTarget::IGNORE_VX |
                                mavros_msgs::PositionTarget::IGNORE_VY |
                                mavros_msgs::PositionTarget::IGNORE_VZ |
                                mavros_msgs::PositionTarget::IGNORE_AFX |
                                mavros_msgs::PositionTarget::IGNORE_AFY |
                                mavros_msgs::PositionTarget::IGNORE_AFZ);
      raw_setpoint.position.x = takeoff_point.x();
      raw_setpoint.position.y = takeoff_point.y();
      raw_setpoint.position.z = takeoff_point.z();
      raw_setpoint.yaw = 0.0;
      raw_pub_.publish(raw_setpoint);
      
      //pubReferencePose(takeoff_point, pose_point_);
      //pubGimbal("start");
      pose_yaw = 0.0;

      // 起飞只看高度
      if (current_state_.mode == "OFFBOARD" && current_state_.armed )
      {
        distance = sqrt(pow(mavPos_(2) - takeoff_point.z(), 2));
        
        if (distance < 0.1) 
        {  
          if (vision_start_time_.time_since_epoch().count() == 0) {
              vision_start_time_ = std::chrono::steady_clock::now();
          }
          auto elapsed = std::chrono::duration_cast<std::chrono::seconds>(
                          std::chrono::steady_clock::now() - vision_start_time_
                        ).count();                    

          prexYaw_ = pose_yaw;

          if (elapsed >= 0.5)
          {
            ROS_INFO("[WAITING_FOR_HOME_POSE] fly to first point, [WAITING_FOR_HOME_POSE----->VISION_GEN_PT]");

            target_point_ = path_to_end.front();
            
            Gen_temp_points(takeoff_point, target_point_, temp_vec);
            std::stringstream ss;
            ss << "[WAITING_FOR_HOME_POSE] takeoff_point:" << takeoff_point(0) << " " << takeoff_point(1) << " " << takeoff_point(2) << ","
              << "target_point_:" << target_point_(0) << " " << target_point_(1) << " " << target_point_(2) << "\n";          
            ROS_INFO_STREAM(ss.str());
            node_state_ = TEMP_PT;

            vision_start_time_ = {};  // 重置时间戳
            LOGGER::DailyLogger::getInstance().Info(ss.str().c_str());
            // std::thread trd(gimbal_left_up, std::ref(udp_gimbal)); //云台相机控制
            // trd.detach();
          }          
        }
        else 
        {
          vision_start_time_ = {}; 
        }
      }     
      break;
    }
    case TEMP_PT: //中间临时点坐标
    {
      if(!temp_vec.empty()) 
      {
        temp_target_point_ = temp_vec.front();
        //pubReferencePose(temp_target_point_, pose_point_);
        
        mavros_msgs::PositionTarget raw_setpoint;
        raw_setpoint.header.frame_id = "map";
        raw_setpoint.header.stamp = ros::Time::now();
        raw_setpoint.coordinate_frame = mavros_msgs::PositionTarget::FRAME_LOCAL_NED;

        raw_setpoint.type_mask = (mavros_msgs::PositionTarget::IGNORE_VX |
                                  mavros_msgs::PositionTarget::IGNORE_VY |
                                  mavros_msgs::PositionTarget::IGNORE_VZ |
                                  mavros_msgs::PositionTarget::IGNORE_AFX |
                                  mavros_msgs::PositionTarget::IGNORE_AFY |
                                  mavros_msgs::PositionTarget::IGNORE_AFZ);
        raw_setpoint.position.x = temp_target_point_.x();
        raw_setpoint.position.y = temp_target_point_.y();
        raw_setpoint.position.z = temp_target_point_.z();
        raw_setpoint.yaw = prexYaw_;

        raw_pub_.publish(raw_setpoint);

        // 计算三维距离
        const double distance = (mavPos_ - temp_target_point_).norm();        

        if(distance < 0.3) { // 到达容差范围内
          // 记录超时开始时间
          if (overload_start_time_.time_since_epoch().count() == 0) {
              overload_start_time_ = std::chrono::steady_clock::now();
          }
          // 检查是否超时
          auto elapsed = std::chrono::duration_cast<std::chrono::seconds>(
              std::chrono::steady_clock::now() - overload_start_time_
          ).count();

          if (elapsed > 0.1)
          {
            temp_vec.erase(temp_vec.begin());
            ROS_INFO("Reached intermediate point [TEMP_PT----->TEMP_PT]");
            std::stringstream ss;
            ss<<"[TEMP_PT----->TEMP_PT] distance:"<<distance<<","<<"temp_target_point_:"<<temp_target_point_(0)<<" "<<temp_target_point_(1)<<" "<<temp_target_point_(2)<<"\n";
            //ROS_INFO_STREAM("[TEMP_PT----->TEMP_PT] distance:" << distance << "," << "temp_target_point_:" << temp_target_point_(0) << " " << temp_target_point_(1) << " " << temp_target_point_(2) << "\n");
            LOGGER::DailyLogger::getInstance().Info(ss.str().c_str());
          }           
        }         
        break;
      }
      else
      {
        Eigen::Vector3d target_point_next_ = path_to_end.front();
        std::stringstream ss;
        ss<<"[TEMP_PT----->VISION_PT_GEN] NO temp point, "<<"next point:"<<target_point_next_.x()<<","<<target_point_next_.y()<<","<<target_point_next_.z();
        LOGGER::DailyLogger::getInstance().Info(ss.str().c_str());
        node_state_ = VISION_PT_GEN;        
      }
    }    
    case VISION_PT_GEN:{
      // 飞往路径的检测点，状态机分开是因为后续云台接口 //path_to_end, posyaw_to_end, posvel_to_end, poshold_to_end, fsm_to_end
      if (!path_to_end.empty()) 
      {
        //overload_time_num++;
        target_point_ = path_to_end.front();
        posyaw_  = posyaw_to_end.front();
        posvel_ = posvel_to_end.front();
        poshold_ = poshold_to_end.front();
        fsm_flag_ = fsm_to_end.front();
                        
        // pubReferencePose(target_point_, pose_point_);
        // node_state_ = VISION_PT_GEN;
        px4_param_set("MPC_XY_VEL_MAX", posvel_);
        {
          float pos_vel;
          bool ret = px4_param_get("MPC_XY_VEL_MAX", pos_vel);
          if (ret)
          {
            ROS_INFO_STREAM("[VISION_PT_GEN] get param OK, MPC_XY_VEL_MAX:"<<pos_vel);
          }
          else
          {
            ROS_INFO_STREAM("[VISION_PT_GEN] get param NG, MPC_XY_VEL_MAX:"<<pos_vel);
          }
        }        

        mavros_msgs::PositionTarget raw_setpoint;
        raw_setpoint.header.frame_id = "map";
        raw_setpoint.header.stamp = ros::Time::now();
        raw_setpoint.coordinate_frame = mavros_msgs::PositionTarget::FRAME_LOCAL_NED;

        raw_setpoint.type_mask = (mavros_msgs::PositionTarget::IGNORE_VX |
                                  mavros_msgs::PositionTarget::IGNORE_VY |
                                  mavros_msgs::PositionTarget::IGNORE_VZ |
                                  mavros_msgs::PositionTarget::IGNORE_AFX |
                                  mavros_msgs::PositionTarget::IGNORE_AFY |
                                  mavros_msgs::PositionTarget::IGNORE_AFZ);
        raw_setpoint.position.x = target_point_.x();
        raw_setpoint.position.y = target_point_.y();
        raw_setpoint.position.z = target_point_.z();
        raw_setpoint.yaw = prexYaw_;
        raw_pub_.publish(raw_setpoint);
      
        distance_xy = sqrt(pow(mavPos_(0) - target_point_.x(), 2) + pow(mavPos_(1) - target_point_.y(), 2));
        distance_z = sqrt(pow(mavPos_(2) - target_point_.z(), 2));
        // if (distance_xy <= 0.05 )  //&& distance_z<=0.1
        if (distance_xy <= 0.1 )
        {
          mavros_msgs::PositionTarget raw_setpoint;
          raw_setpoint.header.frame_id = "map";
          raw_setpoint.header.stamp = ros::Time::now();
          raw_setpoint.coordinate_frame = mavros_msgs::PositionTarget::FRAME_LOCAL_NED;

          raw_setpoint.type_mask = (mavros_msgs::PositionTarget::IGNORE_VX |
                                    mavros_msgs::PositionTarget::IGNORE_VY |
                                    mavros_msgs::PositionTarget::IGNORE_VZ |
                                    mavros_msgs::PositionTarget::IGNORE_AFX |
                                    mavros_msgs::PositionTarget::IGNORE_AFY |
                                    mavros_msgs::PositionTarget::IGNORE_AFZ);
          raw_setpoint.position.x = target_point_.x();
          raw_setpoint.position.y = target_point_.y();
          raw_setpoint.position.z = target_point_.z();
          raw_setpoint.yaw = posyaw_;
          prexYaw_ = posyaw_;
          raw_pub_.publish(raw_setpoint);

          yaw_diff = (posyaw_ == 0) ? std::abs(PI - std::abs(mavros_yaw)) : std::abs(mavros_yaw + posyaw_ - PI * (std::signbit(posyaw_) ? -1 : 1));
          if (yaw_diff < 0.01) //达到目标航向角度
          {
            // 记录超时开始时间
            if (overload_start_time_.time_since_epoch().count() == 0) {
                overload_start_time_ = std::chrono::steady_clock::now();
            }
            // 检查是否超时
            auto elapsed = std::chrono::duration_cast<std::chrono::seconds>(
                std::chrono::steady_clock::now() - overload_start_time_
            ).count();
            
          
            ROS_INFO_STREAM("[VISION PT] yaw_diff:" << yaw_diff<< ",elapsed:" << elapsed << ",poshold_:" << poshold_);
            
            if (elapsed >= poshold_)
            {
              path_to_end.erase(path_to_end.begin());
              posyaw_to_end.erase(posyaw_to_end.begin());
              posvel_to_end.erase(posvel_to_end.begin());
              poshold_to_end.erase(poshold_to_end.begin());
              fsm_to_end.erase(fsm_to_end.begin());
              
              if (!path_to_end.empty())
              {
                overload_start_time_ = {};
                if(fsm_flag_ == 0) //VISION_PT_GEN ---> TEMP_PT
                {                  
                  Eigen::Vector3d target_point_next_ = path_to_end.front();
                  Gen_temp_points(target_point_, target_point_next_, temp_vec);
                  node_state_ = TEMP_PT;
                  std::stringstream ss;
                  ss<<"[VISION_PT_GEN----->TEMP_PT ]"<<"target_point_:"<<target_point_(0)<<" "<<target_point_(1)<<" "<<target_point_(2)<<"\n";
                  ROS_INFO(ss.str().c_str());
                }
                else //VISION_PT_GEN ---> HOLD_PT
                {
                  node_state_ = HOLD_PT;
                  std::stringstream ss;
                  ss<<"[VISION_PT_GEN----->HOLD_PT ]";
                  ROS_INFO(ss.str().c_str());
                }
              }
            }
          }              
        }         
      }
      else
      {
        // 没有点就落地
        ROS_INFO("NO POINT");
        node_state_ = LANDING;
        // node_state_ = HOLD_PT;
      }
      break;
    }
    
    case HOLD_PT:
    {
      if (!path_to_end.empty()) 
      {      
        target_point_ = path_to_end.front();
        posyaw_  = posyaw_to_end.front();
        posvel_ = posvel_to_end.front();
        poshold_ = poshold_to_end.front();
        fsm_flag_ = fsm_to_end.front();
        // pubReferencePose(target_point_, pose_point_);
        if (abs(posyaw_ - prexYaw_) < 0.01)
        {
          ROS_INFO_STREAM("[HOLD_PT] shock yaw:"<<posyaw_<<" =="<<" prexyaw:"<<prexYaw_ );
        }
        else
        {
          ROS_WARN_STREAM("[HOLD_PT] shock yaw:"<<posyaw_<<" <>"<<" prexyaw:"<<prexYaw_);
        }
        if (poshold_<2.0)
        {
          ROS_WARN_STREAM("[HOLD_PT] holding time:"<<poshold_<<" < 2.0 s");
        }

        px4_param_set("MPC_XY_VEL_MAX", posvel_);
        {
          float pos_vel;
          bool ret = px4_param_get("MPC_XY_VEL_MAX", pos_vel);
          if (ret)
          {
            ROS_INFO_STREAM("[HOLD_PT] get param OK, MPC_XY_VEL_MAX:"<<pos_vel);
          }
          else
          {
            ROS_INFO_STREAM("[HOLD_PT] get param NG, MPC_XY_VEL_MAX:"<<pos_vel);
          }
        }  
        mavros_msgs::PositionTarget raw_setpoint;
        raw_setpoint.header.frame_id = "map";
        raw_setpoint.header.stamp = ros::Time::now();
        raw_setpoint.coordinate_frame = mavros_msgs::PositionTarget::FRAME_LOCAL_NED;

        raw_setpoint.type_mask = (mavros_msgs::PositionTarget::IGNORE_VX |
                                  mavros_msgs::PositionTarget::IGNORE_VY |
                                  mavros_msgs::PositionTarget::IGNORE_VZ |
                                  mavros_msgs::PositionTarget::IGNORE_AFX |
                                  mavros_msgs::PositionTarget::IGNORE_AFY |
                                  mavros_msgs::PositionTarget::IGNORE_AFZ);
        raw_setpoint.position.x = target_point_.x();
        raw_setpoint.position.y = target_point_.y();
        raw_setpoint.position.z = target_point_.z();
        raw_setpoint.yaw = prexYaw_;
        raw_pub_.publish(raw_setpoint);

        node_state_ = HOLD_PT;
        std::stringstream ss;
        ss<<"[HOLD_PT TIME ...]";
        ROS_INFO(ss.str().c_str());
        if (std::abs(mavVel_(0)) <= 0.02)
        {
          // 记录超时开始时间
          if (overload_start_time_.time_since_epoch().count() == 0) {
              overload_start_time_ = std::chrono::steady_clock::now();
          }
          // 检查是否超时
          auto elapsed = std::chrono::duration_cast<std::chrono::seconds>(
              std::chrono::steady_clock::now() - overload_start_time_
          ).count();

          if (elapsed > (poshold_ /2) && !isShocked)
          {
            /* code : udp send msg to voice for voice shock*/ 
            isShocked = true;
            udp_shock->sendMessage("{shock}");
            ss<<"[HOLD_PT Shock ...]";
            ROS_INFO(ss.str().c_str());
          }
          if (elapsed > poshold_ && isShocked)
          {
            overload_start_time_ = {};
            isShocked = false;
            node_state_ = VISION_PT_GEN;
            yt_to_end.erase(yt_to_end.begin());
            path_to_end.erase(path_to_end.begin()); 
            pose_to_end.erase(pose_to_end.begin());
            posvel_to_end.erase(posvel_to_end.begin());
            fsm_to_end.erase(fsm_to_end.begin());
            ss<<"[HOLD_PT ----> VISION_PT_GEN]";
            ROS_INFO(ss.str().c_str());
          }          
        }          
      }      

      break;
    }
    case PLANNER_TRAJ_EXEC: {
        // 执行路径规划的轨迹，暂时不开放了
        break;
    }

    case LANDING: {
      target_distance = sqrt(pow(mavPos_(0) - target_point_.x(), 2) +
                            pow(mavPos_(1) - target_point_.y(), 2) +
                            pow(mavPos_(2) - target_point_.z(), 2));
      if(target_distance > 0.1)
      {
        pubReferencePose(target_point_, pose_point_);
        break;
      }
      if(target_point_.z() > 0.8)
      {
        target_point_.z() = 0.8;
        pubReferencePose(target_point_, takeoffq_ref);
        break;
      }
      else // z <= 0.8
      {
        target_point_.z() = 0.6;
        pubReferencePose(target_point_, takeoffq_ref);          
        break;
      }

      if(target_point_.z() > 0.6)
      {
        target_point_.z() = 0.6;
        pubReferencePose(target_point_, pose_point_);
        break;
      }
      if(target_point_.z() == 0.6)
      {
        target_point_.z() = 0.4;
        pubReferencePose(target_point_, pose_point_);
        break;
      }
      
      if(target_distance <= 0.1)
      {          
        ROS_INFO("Landing ...");
        if(px4_param_set("MC_YAWRATE_MAX", 0.0) && px4_param_set("MPC_YAWRAUTO_MAX", 5.0)) {
            ROS_INFO("YAWRATE set ok...");
            set_px4_mode_func("AUTO.LAND");
            node_state_ = LANDED; 
        }
        else
        {
          ROS_WARN("PX4 set yawrate failed, direct atuo land.");
          set_px4_mode_func("AUTO.LAND");
          node_state_ = LANDED; 
        }
      }          
      break;                
    }
    case LANDED:
        ROS_INFO("Landed. Please set to position control and disarm.");
        cmdloop_timer_.stop();
        pubGimbal("stop");
        // ros::Duration(1.0).sleep();
        // // 恢复偏航率参数
        // if(px4_param_set("MC_YAWRATE_MAX", mc_yawrate_max_)) {
        //   ROS_INFO("Restored MC_YAWRATE_MAX to %f", mc_yawrate_max_);
        //   }
        
        break;
  }
}

void geometricCtrl::mavstateCallback(const mavros_msgs::State::ConstPtr &msg) { current_state_ = *msg; }

void geometricCtrl::statusloopCallback(const ros::TimerEvent &event) {
  if (sim_enable_ && false) {
    // Enable OFFBoard mode and arm automatically
    // This will only run if the vehicle is simulated
    arm_cmd_.request.value = true;
    offb_set_mode_.request.custom_mode = "OFFBOARD";
    if (current_state_.mode != "OFFBOARD" && (ros::Time::now() - last_request_ > ros::Duration(5.0))) {
      if (set_mode_client_.call(offb_set_mode_) && offb_set_mode_.response.mode_sent) {
        ROS_INFO("Offboard enabled");
      }
      last_request_ = ros::Time::now();
    } else {
      if (!current_state_.armed && (ros::Time::now() - last_request_ > ros::Duration(5.0))) {
        if (arming_client_.call(arm_cmd_) && arm_cmd_.response.success) {
          ROS_INFO("Vehicle armed");
        }
        last_request_ = ros::Time::now();
      }
    }
  }
  
  pubSystemStatus();
}

void geometricCtrl::pubReferencePose(const Eigen::Vector3d &target_position, const Eigen::Vector4d &target_attitude) {
  geometry_msgs::PoseStamped msg;

  msg.header.stamp = ros::Time::now();
  msg.header.frame_id = "map";
  msg.pose.position.x = target_position(0);
  msg.pose.position.y = target_position(1);
  msg.pose.position.z = target_position(2);
  msg.pose.orientation.w = target_attitude(0);
  msg.pose.orientation.x = target_attitude(1);
  msg.pose.orientation.y = target_attitude(2);
  msg.pose.orientation.z = target_attitude(3);
  referencePosePub_.publish(msg);
  target_pose_pub_.publish(msg);
}

void geometricCtrl::pubRateCommands(const Eigen::Vector4d &cmd, const Eigen::Vector4d &target_attitude) {
  mavros_msgs::AttitudeTarget msg;

  ros::Time t_now = ros::Time::now();
  double control_update_time = (t_now - last_control_).toSec();

  if(control_update_time > 0.1)
  ROS_WARN("time out. %.2f s" ,control_update_time);

  msg.header.stamp = t_now;
  msg.header.frame_id = "map";
  msg.body_rate.x = cmd(0);
  msg.body_rate.y = cmd(1);
  msg.body_rate.z = cmd(2);
  //msg.type_mask = 128;  // Ignore orientation messages
  msg.type_mask = mavros_msgs::AttitudeTarget::IGNORE_ROLL_RATE |
                  mavros_msgs::AttitudeTarget::IGNORE_PITCH_RATE |
                  mavros_msgs::AttitudeTarget::IGNORE_YAW_RATE;
  msg.orientation.w = target_attitude(0);
  msg.orientation.x = target_attitude(1);
  msg.orientation.y = target_attitude(2);
  msg.orientation.z = target_attitude(3);
  msg.thrust = cmd(3);
  last_control_ = t_now;

  angularVelPub_.publish(msg);
}

void geometricCtrl::pubPoseHistory() {
  nav_msgs::Path msg;

  msg.header.stamp = ros::Time::now();
  msg.header.frame_id = "map";
  msg.poses = posehistory_vector_;

  posehistoryPub_.publish(msg);
}

void geometricCtrl::pubSystemStatus() {
  mavros_msgs::CompanionProcessStatus msg;

  msg.header.stamp = ros::Time::now();
  msg.component = 196;  // MAV_COMPONENT_ID_AVOIDANCE
  msg.state = (int)companion_state_;

  systemstatusPub_.publish(msg);
}

void geometricCtrl::appendPoseHistory() {
  posehistory_vector_.insert(posehistory_vector_.begin(), vector3d2PoseStampedMsg(mavPos_, mavAtt_));
  if (posehistory_vector_.size() > posehistory_window_) {
    posehistory_vector_.pop_back();
  }
}

geometry_msgs::PoseStamped geometricCtrl::vector3d2PoseStampedMsg(Eigen::Vector3d &position,
                                                                  Eigen::Vector4d &orientation) {
  geometry_msgs::PoseStamped encode_msg;
  encode_msg.header.stamp = ros::Time::now();
  encode_msg.header.frame_id = "map";
  encode_msg.pose.orientation.w = orientation(0);
  encode_msg.pose.orientation.x = orientation(1);
  encode_msg.pose.orientation.y = orientation(2);
  encode_msg.pose.orientation.z = orientation(3);
  encode_msg.pose.position.x = position(0);
  encode_msg.pose.position.y = position(1);
  encode_msg.pose.position.z = position(2);
  return encode_msg;
}

Eigen::Vector3d geometricCtrl::controlPosition(const Eigen::Vector3d &target_pos, const Eigen::Vector3d &target_vel,
                                               const Eigen::Vector3d &target_acc) {
  /// Compute BodyRate commands using differential flatness
  /// Controller based on Faessler 2017

  /* cout << "target_pos" << target_pos.transpose() << endl;
  cout << "target_vel" << target_pos.transpose() << endl; */
  const Eigen::Vector3d a_ref = target_acc;
  if (velocity_yaw_) {
    // mavYaw_ = getVelocityYaw(mavVel_);
  }

  const Eigen::Vector4d q_ref = acc2quaternion(a_ref - g_, mavYaw_);
  const Eigen::Matrix3d R_ref = quat2RotMatrix(q_ref);

  const Eigen::Vector3d pos_error = mavPos_ - target_pos;
  const Eigen::Vector3d vel_error = mavVel_ - target_vel;

  // Position Controller
  const Eigen::Vector3d a_fb = poscontroller(pos_error, vel_error);

  // Rotor Drag compensation
  const Eigen::Vector3d a_rd = R_ref * D_.asDiagonal() * R_ref.transpose() * target_vel;  // Rotor drag

  // Reference acceleration
  const Eigen::Vector3d a_des = a_fb + a_ref - a_rd - g_;

  return a_des;
}

void geometricCtrl::computeBodyRateCmd(Eigen::Vector4d &bodyrate_cmd, const Eigen::Vector3d &a_des) {
  // Reference attitude
  q_des = acc2quaternion(a_des, mavYaw_);

  // Choose which kind of attitude controller you are running
  bool jerk_enabled = false;
  if (!jerk_enabled) {
    if (ctrl_mode_ == ERROR_GEOMETRIC) {
      bodyrate_cmd = geometric_attcontroller(q_des, a_des, mavAtt_);  // Calculate BodyRate

    } else {
      bodyrate_cmd = attcontroller(q_des, a_des, mavAtt_);  // Calculate BodyRate
    }
  } else {
    bodyrate_cmd = jerkcontroller(targetJerk_, a_des, q_des, mavAtt_);
  }
}

Eigen::Vector3d geometricCtrl::poscontroller(const Eigen::Vector3d &pos_error, const Eigen::Vector3d &vel_error) {

 /* Eigen::Vector3d a_fb =
      Kpos_.asDiagonal() * pos_error + Kvel_.asDiagonal() * vel_error;*/  // feedforward term for trajectory error
  Eigen::Vector3d vel_error_total = 
      (Kpos_.asDiagonal() * pos_error * (-1.0) + vel_error);
  Eigen::Vector3d a_fb = Kvel_.asDiagonal() * vel_error_total + Vel_int;
  //cout << "int:" << Vel_int(0) << ", " << Vel_int(1) << ", " << Vel_int(2) << endl; 
  
  if (a_fb.norm() > max_fb_acc_){
    a_fb = (max_fb_acc_ / a_fb.norm()) * a_fb;  // Clip acceleration if reference is too large
  }
  else{
    Vel_int += Ki_vel_.asDiagonal() * vel_error_total * 0.01;
  }

  return a_fb;
}

Eigen::Vector4d geometricCtrl::acc2quaternion(const Eigen::Vector3d &vector_acc, const double &yaw) {
  Eigen::Vector4d quat;
  Eigen::Vector3d zb_des, yb_des, xb_des, proj_xb_des;
  Eigen::Matrix3d rotmat;
  //cout << "yaw " << yaw << endl;
  proj_xb_des << std::cos(yaw), std::sin(yaw), 0.0;

  zb_des = vector_acc / vector_acc.norm();
  yb_des = zb_des.cross(proj_xb_des) / (zb_des.cross(proj_xb_des)).norm();
  xb_des = yb_des.cross(zb_des) / (yb_des.cross(zb_des)).norm();

  rotmat << xb_des(0), yb_des(0), zb_des(0), xb_des(1), yb_des(1), zb_des(1), xb_des(2), yb_des(2), zb_des(2);
  quat = rot2Quaternion(rotmat);
  return quat;
}

Eigen::Vector4d geometricCtrl::attcontroller(const Eigen::Vector4d &ref_att, const Eigen::Vector3d &ref_acc,
                                             Eigen::Vector4d &curr_att) {
  // Geometric attitude controller
  // Attitude error is defined as in Brescianini, Dario, Markus Hehn, and Raffaello D'Andrea. Nonlinear quadrocopter
  // attitude control: Technical report. ETH Zurich, 2013.

  Eigen::Vector4d ratecmd;

  const Eigen::Vector4d inverse(1.0, -1.0, -1.0, -1.0);
  const Eigen::Vector4d q_inv = inverse.asDiagonal() * curr_att;
  const Eigen::Vector4d qe = quatMultiplication(q_inv, ref_att);
  ratecmd(0) = (2.0 / attctrl_tau_) * std::copysign(1.0, qe(0)) * qe(1);
  ratecmd(1) = (2.0 / attctrl_tau_) * std::copysign(1.0, qe(0)) * qe(2);
  ratecmd(2) = (2.0 / attctrl_tau_) * std::copysign(1.0, qe(0)) * qe(3);
  const Eigen::Matrix3d rotmat = quat2RotMatrix(mavAtt_);
  const Eigen::Vector3d zb = rotmat.col(2);
  ratecmd(3) =
      std::max(0.0, std::min(1.0, norm_thrust_const_ * ref_acc.dot(zb) + norm_thrust_offset_));  // Calculate thrust

  return ratecmd;
}

Eigen::Vector4d geometricCtrl::jerkcontroller(const Eigen::Vector3d &ref_jerk, const Eigen::Vector3d &ref_acc,
                                              Eigen::Vector4d &ref_att, Eigen::Vector4d &curr_att) {
  // Jerk feedforward control
  // Based on: Lopez, Brett Thomas. Low-latency trajectory planning for high-speed navigation in unknown environments.
  // Diss. Massachusetts Institute of Technology, 2016.
  // Feedforward control from Lopez(2016)

  double dt_ = 0.01;
  // Numerical differentiation to calculate jerk_fb
  const Eigen::Vector3d jerk_fb = (ref_acc - last_ref_acc_) / dt_;
  const Eigen::Vector3d jerk_des = ref_jerk + jerk_fb;
  const Eigen::Matrix3d R = quat2RotMatrix(curr_att);
  const Eigen::Vector3d zb = R.col(2);

  const Eigen::Vector3d jerk_vector =
      jerk_des / ref_acc.norm() - ref_acc * ref_acc.dot(jerk_des) / std::pow(ref_acc.norm(), 3);
  const Eigen::Vector4d jerk_vector4d(0.0, jerk_vector(0), jerk_vector(1), jerk_vector(2));

  Eigen::Vector4d inverse(1.0, -1.0, -1.0, -1.0);
  const Eigen::Vector4d q_inv = inverse.asDiagonal() * curr_att;
  const Eigen::Vector4d qd = quatMultiplication(q_inv, ref_att);

  const Eigen::Vector4d qd_star(qd(0), -qd(1), -qd(2), -qd(3));

  const Eigen::Vector4d ratecmd_pre = quatMultiplication(quatMultiplication(qd_star, jerk_vector4d), qd);

  Eigen::Vector4d ratecmd;
  ratecmd(0) = ratecmd_pre(2);  // TODO: Are the coordinate systems consistent?
  ratecmd(1) = (-1.0) * ratecmd_pre(1);
  ratecmd(2) = 0.0;
  ratecmd(3) =
      std::max(0.0, std::min(1.0, norm_thrust_const_ * ref_acc.dot(zb) + norm_thrust_offset_));  // Calculate thrust
  last_ref_acc_ = ref_acc;
  return ratecmd;
}

Eigen::Vector4d geometricCtrl::geometric_attcontroller(const Eigen::Vector4d &ref_att, const Eigen::Vector3d &ref_acc,
                                                       Eigen::Vector4d &curr_att) {
  // Geometric attitude controller
  // Attitude error is defined as in Lee, Taeyoung, Melvin Leok, and N. Harris McClamroch. "Geometric tracking control
  // of a quadrotor UAV on SE (3)." 49th IEEE conference on decision and control (CDC). IEEE, 2010.
  // The original paper inputs moment commands, but for offboard control, angular rate commands are sent

  Eigen::Vector4d ratecmd;
  Eigen::Matrix3d rotmat;    // Rotation matrix of current attitude
  Eigen::Matrix3d rotmat_d;  // Rotation matrix of desired attitude
  Eigen::Vector3d error_att;

  rotmat = quat2RotMatrix(curr_att);
  rotmat_d = quat2RotMatrix(ref_att);

  error_att = 0.5 * matrix_hat_inv(rotmat_d.transpose() * rotmat - rotmat.transpose() * rotmat_d);
  ratecmd.head(3) = (2.0 / attctrl_tau_) * error_att;
  rotmat = quat2RotMatrix(mavAtt_);
  const Eigen::Vector3d zb = rotmat.col(2);
  ratecmd(3) =
      std::max(0.0, std::min(1.0, norm_thrust_const_ * ref_acc.dot(zb) + norm_thrust_offset_));  // Calculate thrust

  return ratecmd;
}

bool geometricCtrl::ctrltriggerCallback(std_srvs::SetBool::Request &req, std_srvs::SetBool::Response &res) {
  unsigned char mode = req.data;

  ctrl_mode_ = mode;
  res.success = ctrl_mode_;
  res.message = "controller triggered";
  return true;
}

void geometricCtrl::dynamicReconfigureCallback(geometric_controller::GeometricControllerConfig &config,
                                               uint32_t level) {
  if (max_fb_acc_ != config.max_acc) {
    max_fb_acc_ = config.max_acc;
    ROS_INFO("Reconfigure request : max_acc = %.2f ", config.max_acc);
  } else if (Kpos_x_ != config.Kp_x) {
    Kpos_x_ = config.Kp_x;
    ROS_INFO("Reconfigure request : Kp_x  = %.2f  ", config.Kp_x);
  } else if (Kpos_y_ != config.Kp_y) {
    Kpos_y_ = config.Kp_y;
    ROS_INFO("Reconfigure request : Kp_y  = %.2f  ", config.Kp_y);
  } else if (Kpos_z_ != config.Kp_z) {
    Kpos_z_ = config.Kp_z;
    ROS_INFO("Reconfigure request : Kp_z  = %.2f  ", config.Kp_z);
  } else if (Kvel_x_ != config.Kv_x) {
    Kvel_x_ = config.Kv_x;
    ROS_INFO("Reconfigure request : Kv_x  = %.2f  ", config.Kv_x);
  } else if (Kvel_y_ != config.Kv_y) {
    Kvel_y_ = config.Kv_y;
    ROS_INFO("Reconfigure request : Kv_y =%.2f  ", config.Kv_y);
  } else if (Kvel_z_ != config.Kv_z) {
    Kvel_z_ = config.Kv_z;
    ROS_INFO("Reconfigure request : Kv_z  = %.2f  ", config.Kv_z);
  } else if (Ki_vel_x_ != config.Kiv_x)
  {
     Ki_vel_x_ = config.Kiv_x;
    ROS_INFO("Reconfigure request : Ki_vel_x_  = %.2f  ", config.Kiv_x);
  } else if (Ki_vel_y_ != config.Kiv_y)
  {
     Ki_vel_y_ = config.Kiv_y;
    ROS_INFO("Reconfigure request : Ki_vel_y_  = %.2f  ", config.Kiv_y);
  } else if (Ki_vel_z_ != config.Kiv_z)
  {
     Ki_vel_z_ = config.Kiv_z;
    ROS_INFO("Reconfigure request : Ki_vel_z_  = %.2f  ", config.Kiv_z);
  }

  Kpos_ << -Kpos_x_, -Kpos_y_, -Kpos_z_;
  Kvel_ << -Kvel_x_, -Kvel_y_, -Kvel_z_;
  Ki_vel_ << -Ki_vel_x_, -Ki_vel_y_, -Ki_vel_z_;
}

