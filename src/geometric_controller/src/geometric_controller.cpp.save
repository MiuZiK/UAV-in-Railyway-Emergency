std::vector<Eigen::Vector3d> geometricCtrl::generatePoint(Eigen::Vector3d &start_pt,Eigen::Vector3d &end_pt, double samples_distance, bool vision_flag)
{
  std::vector<Eigen::Vector3d> sample_points;
  Eigen::Vector3d sample_pt;
  int samples_num;
  double axis_distance_max;
  if(!vision_flag)
  {
    // 比赛里面Y方向几乎不动，Z不希望动，X方向动作较多，初始规划只规划X，
    // 而在视觉时，Z可能也有动作，再同时调整X，Y
    axis_distance_max = std::max((end_pt.x()-start_pt.x()),(end_pt.y()-start_pt.y()));
    samples_num = floor(axis_distance_max/samples_distance);
    if(samples_num > 0)
    {
      for (int i = 0; i <= samples_num; ++i) {
        sample_pt.x() = start_pt.x() + (end_pt.x() - start_pt.x()) * i / samples_num;
        sample_pt.y() = start_pt.y() + (end_pt.y() - start_pt.y()) * i / samples_num;
        sample_pt.z() = start_pt.z() + (end_pt.z() - start_pt.z()) * i / samples_num;
        sample_points.push_back(sample_pt);
      }
      //floor是向下取整，这时候还差一个终点没给
      sample_points.push_back(end_pt);
    }
    else
    {
      sample_points.push_back(end_pt);
    }

    
  }
  else
  {
    // 比赛里面Y方向几乎不动，Z不希望动，X方向动作较多，初始规划只规划X，
    // 而在视觉时，Z可能也有动作，再同时调整X，Y，暂时一样，有需求在改
    axis_distance_max = std::max((end_pt.x()-start_pt.x()),(end_pt.y()-start_pt.y()));
    samples_num = floor(axis_distance_max/samples_distance);
    if(samples_num > 0)
    {
      for (int i = 0; i <= samples_num; ++i) {
        sample_pt.x() = start_pt.x() + (end_pt.x() - start_pt.x()) * i / samples_num;
        sample_pt.y() = start_pt.y() + (end_pt.y() - start_pt.y()) * i / samples_num;
        sample_pt.z() = start_pt.z() + (end_pt.z() - start_pt.z()) * i / samples_num;
        sample_points.push_back(sample_pt);
      }
      //floor是向下取整，这时候还差一个终点没给
      sample_points.push_back(end_pt);
    }
    else
    {
      sample_points.push_back(end_pt);
    }
  }

  return sample_points;
}
void geometricCtrl::VisiontargetCallback(const geometry_msgs::Point &msg) {
  Visiontarget_detect_flag_ = true;
  ROS_INFO("[Visiontarget] VISION POINT %f,%f,%f ",msg.x,msg.y,msg.z);
  Visiontarget_count_ = 1;
  
}
