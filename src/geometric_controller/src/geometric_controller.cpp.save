bool geometricCtrl::px4_param_set(const std::string param_id, double value) {
  mavros_msgs::ParamSet srv;
  srv.request.param_id = param_id;
  srv.request.value.real = value;
  
  if (px4_param_set_client_.call(srv)) {
      if (srv.response.success) {
          ROS_INFO("Set %s to %.1f successful", param_id.c_str(), srv.response.value.real);
          return true;
      } else {
          ROS_ERROR("PX4 rejected setting %s", param_id.c_str());
          return false;
      }
  } else {
      ROS_ERROR("Service call failed for set: %s", param_id.c_str());
      return false;
  }
}

bool geometricCtrl::px4_param_get(const std::string param_id, float& value)
{
  mavros_msgs::ParamGet srv;
  srv.request.param_id = param_id;
  if (px4_param_get_client_.call(srv)) {
    if (srv.response.success) {
      value = srv.response.value.real;
      ROS_INFO_STREAM("Get px4 param:"<<param_id<<", value:"<<value);
      return true;
    }else{
      ROS_ERROR("PX4 rejected getting %s", param_id.c_str());
      return false;
    }
  }else{
    ROS_ERROR("Service call failed for get: %s", param_id.c_str());
    return false;
  }
}

void geometricCtrl::set_px4_mode_func(string mode)
{
  mavros_msgs::SetMode mode_cmd;
  mode_cmd.request.custom_mode = mode;
  set_mode_client_.call(mode_cmd);
}

bool geometricCtrl::checkParamValue(const std::string& param_id, double expected_value, double tolerance ) {
  mavros_msgs::ParamGet srv;
  srv.request.param_id = param_id;

  // ROS_INFO("🔍 Checking %s value...", param_id.c_str());

  if (px4_param_get_client_.call(srv)) {
      if (srv.response.success) {
          double actual_value = srv.response.value.real;
          // ROS_INFO("📊 %s - Expected: %.1f, Actual: %.1f", 
                    // param_id.c_str(), expected_value, actual_value);
          
          if (std::abs(actual_value - expected_value) <= tolerance) {
              // ROS_INFO("✅ %s value matches expected: %.1f", param_id.c_str(), actual_value);
              return true;
          } else {
              // ROS_WARN("⚠️ %s value mismatch: expected %.1f, got %.1f", 
                        // param_id.c_str(), expected_value, actual_value);
              return false;
          }
      } else {
          // ROS_ERROR("❌ Failed to get parameter %s", param_id.c_str());
          return false;
      }
  } else {
      // ROS_ERROR("❌ Service call failed for get: %s", param_id.c_str());
      return false;
  }
}
